# .gitconfig for WSL
#
# |  | /__` |
# |/\| .__/ |___
#

# ── Identity ────────────────────────────────────────────────────────────────

[user]
  name = {{GIT_NAME}}
  email = {{EMAIL_WORK}}
  signingkey = {{SIGNING_KEY}}

{{PERSONAL_BLOCK}}

# ── General ─────────────────────────────────────────────────────────────────

[init]
  defaultBranch = main

[fetch]
  prune = true

# ── Commit signing (1Password SSH agent) ────────────────────────────────────
# https://developer.1password.com/docs/ssh/integrations/wsl/
#
# Uses a wrapper script that routes signing to 1Password (op-ssh-sign-wsl.exe)
# and verification to native ssh-keygen (avoids WSL path garbling).

[gpg]
  format = ssh

[gpg "ssh"]
  program = {{HOME}}/.ssh/git-ssh-sign.sh
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

# ── Credentials ─────────────────────────────────────────────────────────────
# Uses a wrapper script that probes known Git-for-Windows install
# locations, since Windows/Git updates can move git-credential-manager.exe
# between architecture-specific folders (mingw64 vs clangarm64).

[credential]
  helper = {{HOME}}/.ssh/git-credential-manager-wrapper.sh

[credential "https://dev.azure.com"]
  useHttpPath = true
