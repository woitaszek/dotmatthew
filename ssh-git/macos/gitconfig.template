# .gitconfig for macOS
#
# |\/|  /\  /  ` /  \ /__`
# |  | /~~\ \__, \__/ .__/

# ── Identity ────────────────────────────────────────────────────────────────

[user]
  name = {{GIT_NAME}}
  email = {{EMAIL_WORK}}
  signingkey = {{SIGNING_KEY}}

{{PERSONAL_BLOCK}}

# ── General ─────────────────────────────────────────────────────────────────

[init]
  defaultBranch = main

[fetch]
  prune = true

# ── Commit signing (1Password SSH agent) ────────────────────────────────────
# https://developer.1password.com/docs/ssh/get-started/

[gpg]
  format = ssh

[gpg "ssh"]
  program = {{SIGNING_PROGRAM}}
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true